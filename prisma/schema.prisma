generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Opportunity {
  id                      String  @id @default(cuid())
  name                    String  @unique
  kind                    String // "SCHOLARSHIP" | "UNIVERSITY"
  provider                String
  country                 String
  countryCode             String // ISO2 lowercase, for flag emoji
  continent               String
  city                    String?
  lat                     Float
  lng                     Float

  // Academic scope
  levels                  String // CSV: "undergraduate,masters,phd"
  fields                  String // CSV of course areas ("any" = all fields)

  // Application fee
  feeAmount               Float   @default(0)
  feeCurrency             String  @default("USD")
  feeConfirmedFree        Boolean @default(false)
  feeNote                 String?

  // Funding
  fundingType             String // FULLY_FUNDED | PARTIAL | NO_TUITION | SELF_FUNDED
  fundingNote             String?

  // Recurring application cycle (months 1-12, day 1-31). Rolling = no fixed window
  opensMonth              Int?
  opensDay                Int?
  closesMonth             Int?
  closesDay               Int?
  rolling                 Boolean @default(false)
  cycleNote               String?

  // English proficiency / language
  moiAccepted             Boolean @default(false) // Medium-of-Instruction certificate accepted in lieu of IELTS/TOEFL
  moiNote                 String?
  englishTests            String? // e.g. "IELTS 6.5 / TOEFL 90"
  localLanguageRequired   Boolean @default(false)
  localLanguageNote       String?

  // Document requirements
  recommendationsRequired Boolean @default(false)
  recommendationsCount    Int?
  recommendationsNote     String?
  unofficialTranscripts   Boolean @default(false)
  transcriptsNote         String?
  essayRequired           Boolean @default(false)
  essayNote               String?

  // Guidance
  applicationSteps        String // JSON array [{ title, detail }]
  requirementsSummary     String?
  eligibilityNote         String?
  officialUrl             String
  competitiveNote         String?
  successTips             String?
}
